# --- API ---
API_PORT=8000
API_WORKERS=1
REQUEST_TIMEOUT_MS=5000

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TIMEOUT_MS=1000
REDIS_RETRY_COUNT=2
REDIS_MAX_CONNECTIONS=10
REDIS_CACHE_TTL_SECONDS=60

# --- MySQL ---
DB_HOST=mysql
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=apppass
DB_NAME=orderflow
DB_MAX_CONNECTIONS=10
DB_QUERY_TIMEOUT_MS=5000
